<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AndroidLabApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnAndroid">
        <activity
            android:name="com.app.androidlab.sample.network.NetworkActivity"
            android:exported="false" />
        <activity
            android:name="com.app.androidlab.sample.playground.PlaygroundActivity"
            android:exported="false" />
        <activity
            android:name="com.app.androidlab.sample.runtime.RuntimeActivity"
            android:exported="false" />
        <activity
            android:name="com.app.androidlab.sample.system.SysInfoActivity"
            android:exported="false" />
        <activity
            android:name="com.app.androidlab.sample.crypto.CryptoActivity"
            android:exported="true" />
        <activity
            android:name="com.app.androidlab.sample.base.DefaultActivity"
            android:exported="true" />
        <activity
            android:name="com.app.androidlab.sample.AndroidLabMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 移除未实现的 MyService，解决 lint 错误 -->
        

    </application>

</manifest>
